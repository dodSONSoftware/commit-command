{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Commit Command",
  "version": "0.2.6",
  "identifier": "dev.gitfleet.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:1420"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; frame-src 'none'; form-action 'none'",
      "capabilities": [
        "main",
        "settings",
        "ai-suggestions"
      ],
      "assetProtocol": {
        "enable": false,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/CommitCommand.icns",
      "icons/icon.png"
    ]
  }
}
